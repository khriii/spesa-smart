{
  "manifest_version": 3,
  "name": "Iperal Session Sync",
  "version": "1.0",
  "description": "Aggiorna la sessione dell'app Iperal personale con un click.",
  "permissions": ["cookies"],
  "host_permissions": [
    "*://*.iperalspesaonline.it/*",
    "http://TUO_IP:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aggiorna sessione Iperal"
  }
}
