# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Iperal Spesa Online session cookies (optional default session on server startup)
IPERAL_JSESSIONID=
IPERAL_EBSN_ACCOUNT=

# Optional home-server API key to protect proxy endpoints (/api/*)
IPERAL_PROXY_API_KEY=

# Optional secret to keep encrypted browser session cookies valid across server restarts
IPERAL_SESSION_SECRET=
